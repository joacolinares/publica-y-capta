# Claude (adapta el tono de los textos no técnicos). Sin esta clave se entrega el texto base.
ANTHROPIC_API_KEY=
# Opcional: otro modelo. Por defecto claude-opus-5-5. Más barato: claude-haiku-5-5
CLAUDE_MODEL=

# Firebase (consola > Configuración del proyecto)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
# Contenido completo del archivo .json de la cuenta de servicio (sirve en una línea, con saltos o en base64)
FIREBASE_SERVICE_ACCOUNT=

# Impul Tienda (Configuraciones > Webhooks, solo en el plan Max). Clave de firma del endpoint:
IMPULTIENDA_WEBHOOK_SECRET=
# Respaldo por API: Impul todavía no publica su API (oct-2026). Déjalo vacío hasta que exista.
IMPULTIENDA_API_KEY=
IMPULTIENDA_API_URL=https://api.impultienda.ar
# Ids de producto en Impul. Si cargas IMPUL_PRODUCTO_PACK, un id desconocido no da acceso; si no, cualquier otro producto cuenta como el pack.
IMPUL_PRODUCTO_PACK=
IMPUL_PRODUCTO_BUMP=
IMPUL_PRODUCTO_UPSELL=

# Correo (Resend): link de descarga del pack y respaldo del correo de compra
RESEND_API_KEY=
# Remitente con dominio verificado en Resend, por ejemplo: Publica y Capta <hola@tudominio.com>
CORREO_REMITENTE=
# URL pública de la app (la de Railway o tu dominio), sin barra final
APP_URL=
