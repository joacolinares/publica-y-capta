# Claude (adapta el tono de los textos no técnicos). Sin esta clave se entrega el texto base.
ANTHROPIC_API_KEY=
# Opcional: otro modelo. Por defecto claude-opus-5-5. Más barato: claude-haiku-5-5
CLAUDE_MODEL=

# Firebase (consola > Configuración del proyecto)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
# Contenido completo del archivo .json de la cuenta de servicio (sirve en una línea, con saltos o en base64)
FIREBASE_SERVICE_ACCOUNT=

# Impul Tienda (Configuraciones > Webhooks, solo en el plan Max). Clave de firma del endpoint:
IMPULTIENDA_WEBHOOK_SECRET=
# Respaldo por API: Impul todavía no publica su API (oct-2026). Déjalo vacío hasta que exista.
IMPULTIENDA_API_KEY=
IMPULTIENDA_API_URL=https://api.impultienda.ar
# Ids de producto en Impul. Si cargas IMPUL_PRODUCTO_PACK, un id desconocido no da acceso; si no, cualquier otro producto cuenta como el pack.
IMPUL_PRODUCTO_PACK=
IMPUL_PRODUCTO_BUMP=
IMPUL_PRODUCTO_UPSELL=

# Correo (Resend): link de descarga del pack y respaldo del correo de compra
RESEND_API_KEY=
# Remitente con dominio verificado en Resend, por ejemplo: Publica y Capta <hola@tudominio.com>
CORREO_REMITENTE=
# Necesaria en producción: correo real donde te llegan las respuestas y las solicitudes de reembolso (el remitente de Resend no recibe correos)
CORREO_RESPUESTAS=
# URL pública de la app con https:// y sin barra final. Usa tu dominio (el mismo que verificaste en Resend),
# por ejemplo https://app.tudominio.com; si no tienes, la de Railway: https://publica-y-capta-production.up.railway.app
APP_URL=

# Página de venta y datos del vendedor. Las NEXT_PUBLIC_ se fijan al construir: cárgalas antes de desplegar
# (si cambias una, vuelve a desplegar). Las del vendedor y el correo de soporte las pide la LFPC antes de la compra:
# el dato que falte no se muestra en la página, la app, el aviso de privacidad ni los términos.
# Link del checkout de tu producto en Impul (el del producto, no /checkout a secas). Sin él, los botones de compra no llevan a tu tienda.
NEXT_PUBLIC_CHECKOUT_URL=
# Precio en pesos que muestra la página (tiene que ser lo mismo que cobra Impul)
NEXT_PUBLIC_PRECIO_MXN=279
# Píxel de Meta para los anuncios (Administrador de eventos > el ID numérico). Carga el mismo en Impul (Configuraciones > Meta)
# para que las compras lleguen al mismo píxel. Vacío: la página no mide nada.
NEXT_PUBLIC_META_PIXEL_ID=
# Correo de soporte: sale en la página de venta, el reembolso, la app, el aviso de privacidad y los correos
NEXT_PUBLIC_CORREO_SOPORTE=
# Quién vende: nombre o razón social, domicilio físico y teléfono
NEXT_PUBLIC_PROVEEDOR_NOMBRE=
NEXT_PUBLIC_PROVEEDOR_DOMICILIO=
NEXT_PUBLIC_PROVEEDOR_TELEFONO=

# Opcional: cuántos diseños se arman a la vez al generar el pack (por defecto 2; más es más rápido pero usa más memoria)
DISENOS_A_LA_VEZ=
