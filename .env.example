# Claude (adapta el tono de los textos no técnicos). Sin esta clave se entrega el texto base.
ANTHROPIC_API_KEY=
# Opcional: otro modelo. Por defecto claude-opus-5-5. Más barato: claude-haiku-5-5
CLAUDE_MODEL=

# Firebase (consola > Configuración del proyecto)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
# JSON completo de la cuenta de servicio, en una sola línea
FIREBASE_SERVICE_ACCOUNT=

# Impul Tienda (panel > Webhooks / API)
IMPULTIENDA_WEBHOOK_SECRET=
IMPULTIENDA_API_KEY=
IMPULTIENDA_API_URL=https://api.impultienda.ar
# Ids de producto en Impul. Cualquier otro producto cuenta como el pack.
IMPUL_PRODUCTO_BUMP=
IMPUL_PRODUCTO_UPSELL=
